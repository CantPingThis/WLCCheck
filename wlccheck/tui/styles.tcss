/* =========================================================
   WLCCheck — Textual stylesheet
   Palette inspired by GitHub dark + terminal green accent
   ========================================================= */

/* ----- Global ------------------------------------------------ */
Screen {
    background: #0d1117;
    color: #e6edf3;
    layers: base overlay;
}

/* ----- Header ------------------------------------------------ */
Header {
    background: #161b22;
    color: #e6edf3;
    text-style: bold;
    border-bottom: tall #21262d;
    height: 1;
    dock: top;
}

HeaderIcon {
    display: none;
}

/* ----- Footer ------------------------------------------------ */
Footer {
    background: #161b22;
    color: #8b949e;
    border-top: tall #21262d;
    height: 1;
    dock: bottom;
}

Footer > .footer--key {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}

Footer > .footer--highlight {
    background: #1f6feb;
    color: #e6edf3;
}

/* ----- Context bar + diff header ----------------------------- */
#context-bar,
#diff-header {
    height: 3;
    background: #161b22;
    border: tall #21262d;
    padding: 0 2;
    margin: 1 1 0 1;
    display: none;
}

.ctx-key {
    color: #8b949e;
    text-style: bold;
    width: auto;
    padding: 0 1 0 0;
}

.ctx-value {
    color: #e6edf3;
    text-style: bold;
    width: auto;
    padding: 0 3 0 0;
}

.ctx-sep {
    color: #30363d;
    width: auto;
    padding: 0 2;
}

.diff-filter-badge {
    color: #388bfd;
    text-style: bold;
    width: auto;
    padding: 0 0 0 1;
}

/* ----- Stats bar --------------------------------------------- */
#stats-bar {
    height: 5;
    margin: 1 1 0 1;
    display: none;
}

.stat-box {
    background: #161b22;
    border: tall #21262d;
    content-align: center middle;
    height: 5;
    margin: 0 1 0 0;
}

.stat-box:last-of-type {
    margin-right: 0;
}

.stat-label {
    color: #8b949e;
    text-style: bold;
    text-align: center;
    width: 1fr;
}

.stat-value {
    text-align: center;
    text-style: bold;
    width: 1fr;
}

#stat-total    { border: tall #30363d; }
#stat-joined   { border: tall #238636; }
#stat-njoin    { border: tall #b91c1c; }
#stat-other    { border: tall #9e6a03; }
#stat-clients  { border: tall #1d4ed8; }

#val-total   { color: #e6edf3; }
#val-joined  { color: #3fb950; }
#val-njoin   { color: #f85149; }
#val-other   { color: #d29922; }
#val-clients { color: #58a6ff; }

/* ----- AP table --------------------------------------------- */
#table-container {
    margin: 1 1 0 1;
    border: tall #21262d;
    height: 1fr;
    display: none;
}

#table-title {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
    padding: 0 2;
    height: 1;
    border-bottom: tall #21262d;
}

DataTable {
    background: #0d1117;
    color: #e6edf3;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

DataTable > .datatable--header-hover {
    background: #21262d;
    color: #e6edf3;
}

DataTable > .datatable--cursor {
    background: #1c2d42;
    color: #e6edf3;
}

DataTable > .datatable--hover {
    background: #161b22;
}

DataTable > .datatable--fixed {
    background: #161b22;
    color: #8b949e;
}

/* ----- Welcome panel ---------------------------------------- */
#welcome-panel {
    align: center middle;
    height: 1fr;
}

#welcome-box {
    width: 60;
    height: 14;
    background: #161b22;
    border: double #30363d;
    padding: 2 4;
    align: center middle;
}

#welcome-title {
    color: #58a6ff;
    text-style: bold;
    text-align: center;
    width: 1fr;
}

#welcome-sub {
    color: #8b949e;
    text-align: center;
    width: 1fr;
    margin-top: 1;
}

#welcome-hint {
    color: #3fb950;
    text-style: bold;
    text-align: center;
    width: 1fr;
    margin-top: 2;
}

/* ----- Loading panel ---------------------------------------- */
#loading-panel {
    align: center middle;
    height: 1fr;
    display: none;
}

#loading-box {
    width: 64;
    height: 16;
    background: #161b22;
    border: tall #21262d;
    padding: 1 3;
}

#loading-title {
    color: #58a6ff;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    width: 1fr;
}

#loading-status {
    color: #8b949e;
    margin-bottom: 1;
    height: 1;
}

#loading-progress {
    margin: 1 0;
}

ProgressBar > .bar--bar {
    color: #1f6feb;
}

ProgressBar > .bar--complete {
    color: #238636;
}

#loading-log {
    height: 6;
    border: tall #21262d;
    background: #0d1117;
    color: #3fb950;
    margin-top: 1;
}

/* ----- Content area (wraps all view panels) ----------------- */
#content-area {
    height: 1fr;
}

/* ----- Dashboard panel -------------------------------------- */
#dashboard-panel {
    height: 1fr;
    display: none;
}

#diff-panel {
    height: 1fr;
    display: none;
}

/* ----- TabbedContent (dashboard) ---------------------------- */
#dashboard-tabs {
    margin: 1 1 1 1;
    height: 1fr;
}

#dashboard-tabs > TabPane {
    padding: 0;
    background: #0d1117;
}

/* ----- TabbedContent (diff) --------------------------------- */
#diff-tabs {
    margin: 1 1 1 1;
    height: 1fr;
}

#diff-tabs > TabPane {
    padding: 0;
    background: #0d1117;
}

/* ----- Shared tab bar style --------------------------------- */
TabbedContent > Tabs {
    background: #161b22;
    border-bottom: tall #21262d;
}

TabbedContent > Tabs > Tab {
    background: #161b22;
    color: #8b949e;
    padding: 0 2;
}

TabbedContent > Tabs > Tab:hover {
    background: #21262d;
    color: #e6edf3;
}

TabbedContent > Tabs > Tab.-active {
    background: #0d1117;
    color: #58a6ff;
    text-style: bold;
    border-top: tall #1f6feb;
}

TabbedContent > Tabs > Tab > Underline {
    display: none;
}

/* ----- DataTable inside tabs -------------------------------- */
#ap-table,
#wlan-table,
#client-table,
#wlc-status-table,
#diff-ap-table,
#diff-wlan-table,
#diff-client-table {
    background: #0d1117;
    color: #e6edf3;
    height: 1fr;
}

/* ----- Credential modal ------------------------------------- */
CredentialModal {
    align: center middle;
}

#cred-dialog {
    width: 52;
    height: auto;
    background: #161b22;
    border: double #388bfd;
    padding: 2 3;
    layer: overlay;
}

/* ----- Run Options modal ------------------------------------ */
RunOptionsModal {
    align: center middle;
}

/* RunOptionsModal uses #connect-dialog (same id) */

/* ----- Connect modal ---------------------------------------- */
ConnectModal {
    align: center middle;
}

#connect-dialog {
    width: 58;
    height: auto;
    background: #161b22;
    border: double #388bfd;
    padding: 2 3;
    layer: overlay;
}

/* ----- Checkbox in modals ----------------------------------- */
Checkbox {
    background: #161b22;
    color: #e6edf3;
    border: none;
    padding: 0 0;
    margin: 0 0 1 0;
}

Checkbox:hover {
    background: #21262d;
}

Checkbox:focus {
    border: tall #388bfd;
}

Checkbox > .toggle--button {
    background: #30363d;
    color: #8b949e;
}

Checkbox.-on > .toggle--button {
    background: #1f6feb;
    color: #e6edf3;
}

#cb-baseline {
    color: #8b949e;
}

#cb-clients {
    color: #d29922;
}

/* ----- Shared modal styles ---------------------------------- */
.dialog-title {
    color: #58a6ff;
    text-style: bold;
    text-align: center;
    width: 1fr;
    margin-bottom: 1;
}

.dialog-rule {
    color: #30363d;
    margin-bottom: 1;
}

.input-label {
    color: #8b949e;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.input-hint {
    color: #484f58;
    margin-bottom: 1;
}

Input {
    background: #0d1117;
    border: tall #30363d;
    color: #e6edf3;
    margin-bottom: 1;
    height: 3;
}

Input:focus {
    border: tall #388bfd;
    background: #0d1117;
}

Input.-valid {
    border: tall #238636;
}

Input.-invalid {
    border: tall #b91c1c;
}

#dialog-buttons {
    margin-top: 1;
    height: 3;
    align: right middle;
}

Button {
    margin-left: 1;
    min-width: 12;
}

Button.primary-btn {
    background: #1f6feb;
    color: #e6edf3;
    border: tall #388bfd;
    text-style: bold;
}

Button.primary-btn:hover {
    background: #388bfd;
}

Button.primary-btn:focus {
    border: tall #58a6ff;
}

Button.cancel-btn {
    background: #21262d;
    color: #8b949e;
    border: tall #30363d;
}

Button.cancel-btn:hover {
    background: #30363d;
    color: #e6edf3;
}

/* ----- Error banner ----------------------------------------- */
#error-bar {
    height: 3;
    background: #3d0c0c;
    border: tall #b91c1c;
    color: #f85149;
    padding: 0 2;
    margin: 1 1 0 1;
    display: none;
    content-align: left middle;
}

/* ----- Diff stats bar --------------------------------------- */
#diff-stats-bar {
    height: 5;
    margin: 1 1 0 1;
    display: none;
}

#diff-stat-critical { border: tall #b91c1c; }
#diff-stat-warning  { border: tall #9e6a03; }
#diff-stat-info     { border: tall #1d4ed8; }
#diff-stat-total    { border: tall #30363d; }

#diff-val-critical { color: #f85149; }
#diff-val-warning  { color: #d29922; }
#diff-val-info     { color: #58a6ff; }
#diff-val-total    { color: #e6edf3; }

/* ----- Diff table ------------------------------------------- */
#diff-table-container {
    margin: 1 1 0 1;
    border: tall #21262d;
    height: 1fr;
    display: none;
}

#diff-table-title {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
    padding: 0 2;
    height: 1;
    border-bottom: tall #21262d;
}

#diff-table {
    background: #0d1117;
    color: #e6edf3;
    height: 1fr;
}

/* ----- Run / Session picker modals -------------------------- */
RunPickerModal,
SessionPickerModal {
    align: center middle;
}

#picker-dialog {
    width: 96;
    height: auto;
    max-height: 32;
    background: #161b22;
    border: double #388bfd;
    padding: 2 3;
    layer: overlay;
}

#picker-hint {
    color: #484f58;
    text-align: center;
    width: 1fr;
    margin-top: 1;
}

#session-table {
    height: 12;
    background: #0d1117;
    border: tall #21262d;
    margin-top: 1;
}

/* ----- WLC picker modal ------------------------------------- */
WLCPickerModal {
    align: center middle;
}

#wlc-selection {
    height: 14;
    background: #0d1117;
    border: tall #21262d;
    margin-top: 1;
}

SelectionList > .selection-list--button {
    color: #8b949e;
}

SelectionList > .selection-list--button-highlighted {
    background: #1c2d42;
    color: #e6edf3;
}

SelectionList > .selection-list--button-selected {
    color: #3fb950;
}

/* ----- WLC status panel ------------------------------------- */
#wlc-status-container {
    margin: 1 1 0 1;
    border: tall #21262d;
    height: auto;
    max-height: 12;
    display: none;
}

#wlc-status-title {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
    padding: 0 2;
    height: 1;
    border-bottom: tall #21262d;
}

/* ----- Hint bar (bottom) ------------------------------------ */
#hint-bar {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 2;
    dock: bottom;
    content-align: left middle;
}

/* ----- Live Monitor panel ----------------------------------- */
#live-panel {
    height: 1fr;
    display: none;
}

/* ----- Live WLC selector bar -------------------------------- */
#live-wlc-bar {
    height: 5;
    background: #161b22;
    border-bottom: tall #21262d;
    padding: 0 1;
    margin: 1 1 0 1;
    overflow-x: auto;
    overflow-y: hidden;
    align: left middle;
}

.live-wlc-btn {
    background: #21262d;
    color: #8b949e;
    border: tall #30363d;
    margin: 0 1 0 0;
    min-width: 16;
    height: 3;
}

.live-wlc-btn:hover {
    background: #30363d;
    color: #e6edf3;
}

.live-wlc-btn.live-wlc-focused {
    background: #1c2d42;
    color: #58a6ff;
    border: tall #388bfd;
    text-style: bold;
}

/* ----- Live stats bar --------------------------------------- */
#live-stats-bar {
    height: 5;
    margin: 1 1 0 1;
}

#live-stat-baseline { border: tall #30363d; }
#live-stat-current  { border: tall #238636; }
#live-stat-delta    { border: tall #9e6a03; }
#live-stat-poll     { border: tall #1d4ed8; }
#live-stat-next     { border: tall #30363d; }

#live-val-baseline { color: #8b949e; }
#live-val-current  { color: #3fb950; }
#live-val-delta    { color: #d29922; }
#live-val-poll     { color: #58a6ff; }
#live-val-next     { color: #58a6ff; }

/* ----- Live tabs -------------------------------------------- */
#live-tabs {
    margin: 1 1 1 1;
    height: 1fr;
}

#live-tabs > TabPane {
    padding: 0;
    background: #0d1117;
}

/* ----- Live tables ------------------------------------------ */
#live-ap-table,
#live-event-table,
#live-history-table {
    background: #0d1117;
    color: #e6edf3;
    height: 1fr;
}

/* ----- Select widget in modals ------------------------------ */
Select {
    background: #0d1117;
    border: tall #30363d;
    color: #e6edf3;
    margin-bottom: 1;
}

Select:focus {
    border: tall #388bfd;
}

Select > SelectCurrent {
    background: #0d1117;
    color: #e6edf3;
}

Select > SelectOverlay {
    background: #161b22;
    border: tall #388bfd;
}

Select > SelectOverlay > .option-list--option {
    color: #e6edf3;
}

Select > SelectOverlay > .option-list--option-highlighted {
    background: #1c2d42;
    color: #58a6ff;
}

/* ----- Command palette -------------------------------------- */
CommandPalette {
    background: #0d1117 60%;
}

CommandPalette > .command-palette--help-text {
    background: #161b22;
    color: #8b949e;
}

CommandPalette Input {
    background: #161b22;
    border: tall #30363d;
    color: #e6edf3;
}

CommandPalette Input:focus {
    border: tall #388bfd;
}

CommandPalette > .command-palette--list {
    background: #161b22;
    border: tall #21262d;
}

CommandPalette > .command-palette--list > .option-list--option {
    color: #e6edf3;
}

CommandPalette > .command-palette--list > .option-list--option-highlighted {
    background: #1c2d42;
    color: #58a6ff;
}
